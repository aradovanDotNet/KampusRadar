@page
@model ErrorModel
@{
    ViewData["Title"] = "Greška";
}

<div class="poruka-stranica">
    <h1>Ups, nešto je pošlo po zlu</h1>
    <p>Dogodila se greška pri obradi zahtjeva. Pokušaj ponovno ili se vrati na početnu stranicu.</p>

    @if (Model.ShowRequestId)
    {
        <p class="tekst-blagi">ID zahtjeva: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-page="/Index">Na početnu</a>
</div>
