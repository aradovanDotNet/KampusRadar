@{
    // Trenutna stranica, npr. "/Dogadaji/Filtriranje" – za isticanje aktivnog linka
    var trenutna = ViewContext.RouteData.Values["page"] as string ?? "";

    string? Aktivna(params string[] stranice) =>
        stranice.Contains(trenutna, StringComparer.OrdinalIgnoreCase) ? "page" : null;
}

<header class="zaglavlje">
    <nav class="navbar navbar-expand-lg container" aria-label="Glavni izbornik">
        <a class="navbar-brand marka" asp-page="/Index">
            <img src="~/images/logo.svg" alt="" width="36" height="36" />
            <span>KampusRadar</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#izbornik"
                aria-controls="izbornik" aria-expanded="false" aria-label="Otvori izbornik">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="izbornik">
            <ul class="navbar-nav me-auto izbornik">
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Index" aria-current="@Aktivna("/Index")">Početna</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Dogadaji/Index"
                       aria-current="@Aktivna("/Dogadaji/Index", "/Dogadaji/Details", "/Dogadaji/Edit", "/Dogadaji/Delete")">Događaji</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Dogadaji/Filtriranje" aria-current="@Aktivna("/Dogadaji/Filtriranje")">Filtriranje</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Dogadaji/Sortirano" aria-current="@Aktivna("/Dogadaji/Sortirano")">Sortirano</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/OProjektu" aria-current="@Aktivna("/OProjektu")">O projektu</a>
                </li>
            </ul>

            <div class="zaglavlje-akcije">
                <button type="button" class="gumb-tema" data-promijeni-temu aria-pressed="false">
                    <span class="gumb-tema-ikona" aria-hidden="true"></span>
                    <span class="gumb-tema-tekst">Tamna tema</span>
                </button>
                <a class="btn btn-primary" asp-page="/Dogadaji/Create">Novi događaj</a>
            </div>
        </div>
    </nav>
</header>
